{
  "description": "Alcance y telemetría del laboratorio en Codex local",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/codex_hook.py pre",
            "timeout": 10,
            "statusMessage": "Comprobando alcance"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/codex_hook.py post",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
